upstream notes {
{% for host in groups["web"] %}
    server {{ host }}:8000;
{% endfor %}
}

server {
    listen 80;

    location / {
        proxy_pass http://notes;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header X-Served-By $upstream_addr always;
    }
}
